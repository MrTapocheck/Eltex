 create mode 100644 README.md
root@eltex-practice2-pg2-v15:~/Eltex# git branch -M main
root@eltex-practice2-pg2-v15:~/Eltex# git remote add origin https://github.com/MrTapocheck/Eltex.git
root@eltex-practice2-pg2-v15:~/Eltex# git status
