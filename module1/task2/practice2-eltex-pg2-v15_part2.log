6)Подсчитайте количество строк в файле /var/log/kern.log
root@eltex-practice2-pg2-v15:~# wc  -l /var/log/kern.log
22 /var/log/kern.log

7)Отформатируйте вывод записей в /var/log/apt/history.log в следующем порядке, построчно:
Commandline: … ; Start-Date: … ; End-Date: …
root@eltex-practice2-pg2-v15:~# cat > /root/parse_apt.awk << 'EOF'
BEGIN { RS = "" }
/Start-Date:/ {
  start_date = $2" "$3
}
/Commandline:/ {
  cmd = $2
}
/End-Date:/ {
  end_date = $2" "$3
  printf "Commandline: %s; Start-Date: %s; End-Date: %s\n", cmd, start_date, end_date
}
EOF
root@eltex-practice2-pg2-v15:~# awk -f parse_apt.awk /var/log/apt/history.log
Commandline: 2025-11-01; Start-Date: 2025-11-01 06:53:35; End-Date: 2025-11-01 06:53:35
