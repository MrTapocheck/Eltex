13)Разрешите user1 выполнять привилегированную команду dmesg при помощи команды sudo, а
user2 – при помощи скрипта на языке bash с установленным флагом SUID
root@eltex-practice2-pg2-v15:~# sudo bash -c 'echo "user1 ALL=(ALL) NOPASSWD: /usr/bin/dmesg" >> /etc/sudoers'
root@eltex-practice2-pg2-v15:~# sudo bash -c 'echo -e "#!/bin/bash\n/usr/bin/dmesg" > /usr/local/bin/dmesg_suid'
root@eltex-practice2-pg2-v15:~# sudo chmod +x /usr/local/bin/dmesg_suid
root@eltex-practice2-pg2-v15:~# sudo chown root:user2 /usr/local/bin/dmesg_suid
root@eltex-practice2-pg2-v15:~# sudo chmod 4750 /usr/local/bin/dmesg_suid

14)Для всех пользователей user* задайте время действия пароля – 10 дней.
root@eltex-practice2-pg2-v15:~# sudo chage -M 10 user*
chage: user 'user*' does not exist in /etc/passwd
root@eltex-practice2-pg2-v15:~# sudo chage -M 10 user1
root@eltex-practice2-pg2-v15:~# sudo chage -M 10 user2
root@eltex-practice2-pg2-v15:~# sudo chage -M 10 user3

15)Отредактируйте файл /etc/motd, вписав туда свое имя и фамилию
root@eltex-practice2-pg2-v15:~# echo "Виталий Тривайлов" > /etc/motd
root@eltex-practice2-pg2-v15:~# cat /etc/motd | tail -n 5
Виталий Тривайлов

16)Создайте копию содержимого каталога /etc в каталог /root/etc_backup при помощи программы
rcync
root@eltex-practice2-pg2-v15:~# rsync -a /etc/ /root/etc_backup/

17)Заархивируйте содержимое каталога /root/etc_backup архиватором tar, используйте алгоритмы
сжатия gzip, bzip2, 7zip, сравните размеры полученных файлов
root@eltex-practice2-pg2-v15:~# tar -czf /root/etc_backup.tar.gz -C /root etc_backup
root@eltex-practice2-pg2-v15:~# tar -cjf /root/etc_backup.tar.bz2 -C /root etc_backup
root@eltex-practice2-pg2-v15:~# 7z a /root/etc_backup.7z /root/etc_backup
root@eltex-practice2-pg2-v15:~# ls -lh /root/etc_backup.*
-rw-r--r-- 1 root root 4.5M Nov  9 21:07 /root/etc_backup.7z
-rw-r--r-- 1 root root 549K Nov  9 21:07 /root/etc_backup.tar.bz2
-rw-r--r-- 1 root root 583K Nov  9 21:06 /root/etc_backup.tar.gz

18)Отредактируйте файл /etc/motd, вписав туда текущую дату и время, синхронизируйте каталог
/root/etc_backup с каталогом /etc при помощи rsync, добавьте файл motd в архив, сжатый gzip
root@eltex-practice2-pg2-v15:~# echo "$(date)" >> /etc/motd
root@eltex-practice2-pg2-v15:~# rsync -a /etc/ /root/etc_backup/
root@eltex-practice2-pg2-v15:~# tar -czf /root/etc_backup-2.tar.gz -C /root etc_backup

19)Сравните содержимое архива, упакованного bzip2 с сорержимым каталога /root/etc_backup
   81  tar -tjf /root/etc_backup.tar.bz2 | sort > /root/archive_bzip2.txt
   82  ls -1R /root/etc_backup | sort > /root/etc_backup.txt
   83  diff /root/archive_bzip2.txt /root/etc_backup.txt

20)Распакуйте архивы etc_backup, упакованные gzip и 7zip в каталоги /root/etc_backup_gzip и
/root/etc_backup_7zip, сравните программой diff файлы motd в этих каталогах.
root@eltex-practice2-pg2-v15:~# mkdir -p /root/etc_backup_gzip /root/etc_backup_7zip
root@eltex-practice2-pg2-v15:~# 7z x /root/etc_backup.7z -o/root/etc_backup_7zip
root@eltex-practice2-pg2-v15:~# tar -xzf /root/etc_backup-2.tar.gz -C /root/etc_backup_gzip
diff: /root/etc_backup_7zip/root/etc_backup/motd: No such file or directory
root@eltex-practice2-pg2-v15:~# diff /root/etc_backup_gzip/etc_backup/motd /root/etc_backup_7zip/etc_backup/motd
2d1
