-rw-rw-r-- 1 user2 user_group    0 Oct 27 05:13 file_user2
-rw-rw-r-- 1 user3 user_group    0 Oct 27 05:13 file_user3
root@eltex-practice2-pg2-v15:~# sudo -u user1 rm -f /opt/share/file_user2
root@eltex-practice2-pg2-v15:~# sudo -u user2 rm -f /opt/share/file_user3
root@eltex-practice2-pg2-v15:~# sudo -u user3 rm -f /opt/share/file_user1

